---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";
import {
  assertBrandColorMode,
  getBrand,
  type BrandName,
  type IconColorMode,
} from "../catalog/index.ts";

interface Props
  extends Omit<
    HTMLAttributes<"svg">,
    | "aria-hidden"
    | "aria-label"
    | "height"
    | "name"
    | "role"
    | "title"
    | "width"
  > {
  name: BrandName;
  /** Label an informative standalone brand mark. Leave absent for decorative use. */
  label?: string;
  description?: string;
  mode?: IconColorMode;
  size?: number | string;
}

const {
  name,
  label,
  description,
  mode = "monochrome",
  size = 24,
  ...attributes
} = Astro.props;

if (description && !label) {
  throw new Error("BrandIcon description requires a label.");
}

const brand = getBrand(name);
assertBrandColorMode(brand, mode);
const resolvedName: any = brand.iconifyName;
---

<Icon
  {...attributes}
  name={resolvedName}
  size={size}
  title={label}
  desc={label ? description : undefined}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
/>
