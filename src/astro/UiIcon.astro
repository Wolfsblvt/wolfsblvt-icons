---
import { Icon } from "astro-icon/components";
import type { HTMLAttributes } from "astro/types";
import { resolveUiIcon, type UiIconName } from "../catalog/index.ts";

interface Props extends Omit<HTMLAttributes<"svg">, "name" | "title"> {
  name: UiIconName;
  /** Label an informative standalone icon. Leave absent for decorative icons. */
  label?: string;
  /** Optional longer description for an informative standalone icon. */
  description?: string;
  size?: number | string;
}

const {
  name,
  label,
  description,
  size = 24,
  ...attributes
} = Astro.props;

if (description && !label) {
  throw new Error("UiIcon description requires a label.");
}

const resolvedName: any = resolveUiIcon(name);
const accessibility = label
  ? { role: "img", "aria-label": label }
  : { "aria-hidden": "true" };
---

<Icon
  {...attributes}
  {...accessibility}
  name={resolvedName}
  size={size}
  title={label}
  desc={label ? description : undefined}
/>
