{
  "name": "@wolfsblvt/icons",
  "version": "0.1.0",
  "description": "The curated icon system for Wolfsblvt Works products.",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Wolfsblvt Works",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wolfsblvt/wolfsblvt-icons.git"
  },
  "bugs": {
    "url": "https://github.com/Wolfsblvt/wolfsblvt-icons/issues"
  },
  "homepage": "https://github.com/Wolfsblvt/wolfsblvt-icons#readme",
  "keywords": [
    "astro",
    "icons",
    "lucide",
    "simple-icons",
    "svg",
    "typescript",
    "wolfsblvt"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "files": [
    "dist",
    "src",
    "LICENSE.md",
    "third-party-notices.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.js"
    },
    "./astro": "./src/astro/index.ts",
    "./astro/UiIcon.astro": "./src/astro/UiIcon.astro",
    "./astro/BrandIcon.astro": "./src/astro/BrandIcon.astro",
    "./astro/ProductIcon.astro": "./src/astro/ProductIcon.astro",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.astro"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "astro:check": "astro check",
    "astro:consumer": "astro check --root . --config tests/fixtures/astro-consumer/astro.config.mjs && astro build --root . --config tests/fixtures/astro-consumer/astro.config.mjs && node scripts/verify-astro-consumer.mjs",
    "clean": "node scripts/clean.mjs",
    "docs:check": "node scripts/check-doc-links.mjs",
    "fixtures": "node scripts/generate-contact-sheet.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate": "node scripts/generate-custom-icons.mjs && node scripts/generate-contact-sheet.mjs",
    "generate:check": "node scripts/generate-custom-icons.mjs --check && node scripts/generate-contact-sheet.mjs --check",
    "pack:check": "node scripts/check-package-boundary.mjs",
    "pack:consumer": "node scripts/check-packed-consumer.mjs",
    "test": "npm run verify",
    "test:unit": "node --test tests/*.test.mjs",
    "validate": "node scripts/validate-assets.mjs",
    "verify": "npm run format:check && npm run build && npm run astro:check && npm run astro:consumer && npm run test:unit && npm run validate && npm run generate:check && npm run docs:check && npm run pack:check && npm run pack:consumer",
    "prepare": "npm run build"
  },
  "dependencies": {
    "@iconify-json/lucide": "1.2.133",
    "@iconify-json/simple-icons": "1.2.96"
  },
  "peerDependencies": {
    "astro": ">=7.0.0 <8.0.0",
    "astro-icon": ">=1.2.0 <2.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "astro": "7.3.3",
    "astro-icon": "1.2.0",
    "prettier": "3.9.8",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
