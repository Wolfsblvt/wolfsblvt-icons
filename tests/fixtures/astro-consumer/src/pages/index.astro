---
import { BrandIcon, ProductIcon, UiIcon } from "@wolfsblvt/icons/astro";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Wolfsblvt Icons consumer fixture</title>
  </head>
  <body>
    <main>
      <section id="ui-settings"><UiIcon name="settings" /></section>
      <section id="ui-direct">
        <UiIcon name="lucide:badge-check" label="Verified" />
      </section>
      <section id="brand-github">
        <BrandIcon name="github" label="GitHub" />
      </section>
      <section id="brand-discord"><BrandIcon name="discord" /></section>
      <section id="product-borrowed-coast-at-war">
        <ProductIcon name="borrowed-coast/at-war" label="At War" />
      </section>
      <section id="product-borrowed-coast-beacon">
        <ProductIcon name="borrowed-coast/beacon" label="Beacon" />
      </section>
      <section id="product-borrowed-coast-chart">
        <ProductIcon name="borrowed-coast/chart" label="Chart" />
      </section>
      <section id="product-borrowed-coast-control">
        <ProductIcon name="borrowed-coast/control" label="Control" />
      </section>
      <section id="product-borrowed-coast-deep-hull-strait">
        <ProductIcon
          name="borrowed-coast/deep-hull-strait"
          label="Deep Hull Strait"
        />
      </section>
      <section id="product-borrowed-coast-guest-mooring">
        <ProductIcon
          name="borrowed-coast/guest-mooring"
          label="Guest Mooring"
        />
      </section>
      <section id="product-borrowed-coast-harbor">
        <ProductIcon name="borrowed-coast/harbor" label="Harbor" />
      </section>
      <section id="product-borrowed-coast-nations">
        <ProductIcon name="borrowed-coast/nations" label="Nations" />
      </section>
      <section id="product-borrowed-coast-no-accord">
        <ProductIcon name="borrowed-coast/no-accord" label="No Accord" />
      </section>
      <section id="product-borrowed-coast-protected-peace">
        <ProductIcon
          name="borrowed-coast/protected-peace"
          label="Protected Peace"
        />
      </section>
      <section id="product-borrowed-coast-tide-phase">
        <ProductIcon name="borrowed-coast/tide-phase" label="Tide Phase" />
      </section>
      <section id="product-borrowed-coast-watch">
        <ProductIcon name="borrowed-coast/watch" label="Watch" />
      </section>
      <section id="product-diffdevil-brand">
        <ProductIcon name="diffdevil/brand" label="diffdevil" />
      </section>
      <section id="product-diffdevil-changed">
        <ProductIcon name="diffdevil/changed" label="Changed" />
      </section>
      <section id="product-diffdevil-raw-churn">
        <ProductIcon name="diffdevil/raw-churn" label="Raw churn" />
      </section>
      <section id="product-diffdevil-bands">
        <ProductIcon name="diffdevil/bands" label="Policy bands" />
      </section>
    </main>
  </body>
</html>
